#!/usr/bin/env bash

send_matching_windows_to_workspace () {
    local window_ids window_id
    window_ids=$(aerospace list-windows --json --all | jq -r --arg field "$1" --arg pattern "$2" \
        '.[] | select((.[$field] // "") | test($pattern)) | ."window-id"') || return
    [ -n "$window_ids" ] || return 0

    while IFS= read -r window_id; do
        aerospace move-node-to-workspace --window-id "$window_id" "$3" > /dev/null 2>&1
        if [ -n "${4:-}" ]; then
            aerospace layout --window-id "$window_id" "$4" > /dev/null 2>&1
        fi
    done <<< "$window_ids"
}

send_app_name_to_workspace () {
    send_matching_windows_to_workspace "app-name" "$@"
}

send_window_title_to_workspace () {
    send_matching_windows_to_workspace "window-title" "$@"
}

current_display_count=$(aerospace list-monitors --count)

