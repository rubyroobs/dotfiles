Match Exec "gpg --card-status 2>/dev/null | grep -Pq '(?<=Serial number).*\K[0-9]{5}009$'"
    PreferredAuthentications    publickey
    IdentitiesOnly              yes
    IdentityFile                ~/.ssh/5AN_009_queen.pub
    IdentityAgent               ~/.gnupg/S.gpg-agent.ssh

